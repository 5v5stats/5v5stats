# Settings for publish.py. They stay on this PC.

# Where to publish: "local" = a folder on this PC served by serve_site.py (simulation, nothing leaves the PC)
#                   "r2"    = Cloudflare R2 (the real website; fill in the R2 section below first)
TARGET=local

# --- local simulation
LOCAL_SITE=C:\cs2render\site
LOCAL_URL=http://localhost:8080

# --- Cloudflare R2 (not used while TARGET=local)
# 1. dash.cloudflare.com > R2 Object Storage > Create bucket (e.g. cs2-highlights)
# 2. Bucket > Settings > Public access > "R2.dev subdomain" > Allow. Copy the https://pub-....r2.dev URL.
# 3. R2 Object Storage > Manage API tokens > Create API token:
#      Permissions: Object Read & Write, limited to this bucket. Copy the Access Key ID and Secret Access Key.
# 4. Your Account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cs2-highlights
PUBLIC_URL=
